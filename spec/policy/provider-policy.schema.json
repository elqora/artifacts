{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-sdk.dev/schema/1.0/policy/provider-policy.schema.json",
  "title": "ArtifactProviderPolicy",
  "type": "object",
  "required": ["actors"],
  "properties": {
    "actors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "mode": { "enum": ["single", "any", "all"] },
    "delegation": { "enum": ["forbidden", "allowed"] }
  },
  "additionalProperties": true
}
