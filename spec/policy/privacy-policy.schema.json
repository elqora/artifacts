{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-sdk.dev/schema/1.1/policy/privacy-policy.schema.json",
  "title": "ArtifactPrivacyPolicy",
  "type": "object",
  "required": ["classification"],
  "properties": {
    "classification": { "enum": ["public", "internal", "private", "sensitive", "restricted"] },
    "reveal": { "type": "array", "items": { "$ref": "#/$defs/revealRule" } },
    "masking": { "$ref": "#/$defs/masking" },
    "encryption": { "$ref": "#/$defs/encryption" }
  },
  "additionalProperties": true,
  "$defs": {
    "revealRule": {
      "title": "ArtifactRevealRule",
      "type": "object",
      "required": ["actors", "representation"],
      "properties": {
        "actors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "when": { "$ref": "https://artifact-sdk.dev/schema/1.1/policy/condition.schema.json" },
        "representation": { "enum": ["hidden", "masked", "approximate", "full"] }
      },
      "additionalProperties": true
    },
    "masking": {
      "title": "ArtifactMaskingPolicy",
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "config": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "encryption": {
      "title": "ArtifactEncryptionPolicy",
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "level": { "type": "string", "minLength": 1 },
        "keyScope": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
