{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-sdk.dev/schema/1.1/policy/validation-policy.schema.json",
  "title": "ArtifactValidationPolicy",
  "type": "object",
  "properties": {
    "mode": { "enum": ["strict", "lenient"] },
    "schema": {
      "type": "object",
      "description": "Serializable Laravel-style validation rules applied by the host to the artifact specification value. Keys are exact field paths such as locations or locations.name; values are pipe-form rule strings or arrays of rule strings.",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        ]
      }
    },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "additionalProperties": true,
  "$defs": {
    "rule": {
      "title": "ArtifactValidationRule",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "config": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  }
}
