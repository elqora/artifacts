{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-sdk.dev/schema/1.0/policy/access-policy.schema.json",
  "title": "ArtifactAccessPolicy",
  "type": "object",
  "properties": {
    "read": { "$ref": "#/$defs/rules" },
    "write": { "$ref": "#/$defs/rules" },
    "submit": { "$ref": "#/$defs/rules" },
    "verify": { "$ref": "#/$defs/rules" }
  },
  "additionalProperties": true,
  "$defs": {
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "rule": {
      "type": "object",
      "required": ["actors"],
      "properties": {
        "actors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "condition": { "$ref": "https://artifact-sdk.dev/schema/1.0/policy/condition.schema.json" }
      },
      "additionalProperties": true
    }
  }
}
